-- EEG LIVE MVP
-- Uses the standard SuperDirt "supermandolin" synth family by default.
-- The mappings below are artistic defaults, not scientifically mandatory
-- relationships. Edit this file—not Python—to explore texture, rhythm,
-- dynamics, harmony, timbre, space, fast, off timing, or juxBy structures.

-- 1. EXTERNAL EEG CONTROL DEFINITIONS ---------------------------------------
let eeg1Energy   = cF 0.5 "eeg1_energy"
    eeg1Centroid = cF 0.5 "eeg1_centroid"
    eeg1Mobility = cF 0.5 "eeg1_mobility"
    eeg2Energy   = cF 0.5 "eeg2_energy"
    eeg2Centroid = cF 0.5 "eeg2_centroid"
    eeg2Mobility = cF 0.5 "eeg2_mobility"
    eeg3Energy   = cF 0.5 "eeg3_energy"
    eeg3Centroid = cF 0.5 "eeg3_centroid"
    eeg3Mobility = cF 0.5 "eeg3_mobility"
    eeg4Energy   = cF 0.5 "eeg4_energy"
    eeg4Centroid = cF 0.5 "eeg4_centroid"
    eeg4Mobility = cF 0.5 "eeg4_mobility"
    eeg5Energy   = cF 0.5 "eeg5_energy"
    eeg5Centroid = cF 0.5 "eeg5_centroid"
    eeg5Mobility = cF 0.5 "eeg5_mobility"
    eeg6Energy   = cF 0.5 "eeg6_energy"
    eeg6Centroid = cF 0.5 "eeg6_centroid"
    eeg6Mobility = cF 0.5 "eeg6_mobility"

-- 2. EDITABLE MAPPING RANGES AND FIXED PITCH SCAFFOLD ----------------------
-- C-major-sixth scaffold: edit these six pitches in one place.
-- Other synths noted in experiments/soundSample.tidal: "superhammond", "supervibe",
-- "superfork", and "superpwm". Change voiceSound once to change all voices.
let voiceSound = "supermandolin"
    f3Pitch = "c3"
    f4Pitch = "e3"
    c3Pitch = "g3"
    c4Pitch = "a3"
    p3Pitch = "c4"
    p4Pitch = "e4"
    gainLow = 0.55
    gainHigh = 1.85
    djfLow = 0.15
    djfHigh = 0.85
    roomLow = 0.05
    roomHigh = 0.95
    sizeLow = 0.20
    sizeHigh = 0.95
    dryLow = 0.90
    dryHigh = 0.45
    sustainShort = 0.85
    sustainLong = 3.5
let inverseSustain energyControl centroidControl =
      range sustainShort sustainLong
      $ 1 - ((energyControl * centroidControl) / 2)
      -- 如果需要更drastic改乘法

-- 3. SIX VOICE DEFINITIONS -------------------------------------------------
-- One finite event per voice per cycle keeps SuperDirt load predictable.
-- Inactive future alternative: replace djf with
--   # note (range (-12) 12 eeg1Centroid)
-- for a continuous centroid-to-register mapping.
let f3Voice = s voiceSound # n f3Pitch # sustain (inverseSustain eeg1Energy eeg1Centroid)
      # gain (range gainLow gainHigh eeg1Energy)
      # djf (range djfLow djfHigh eeg1Centroid)
      # room (range roomLow roomHigh eeg1Mobility)
      # size (range sizeLow sizeHigh eeg1Mobility)
      # dry (range dryLow dryHigh eeg1Mobility) # pan 0.05
    f4Voice = s voiceSound # n f4Pitch # sustain (inverseSustain eeg2Energy eeg2Centroid)
      # gain (range gainLow gainHigh eeg2Energy)
      # djf (range djfLow djfHigh eeg2Centroid)
      # room (range roomLow roomHigh eeg2Mobility)
      # size (range sizeLow sizeHigh eeg2Mobility)
      # dry (range dryLow dryHigh eeg2Mobility) # pan 0.23
    c3Voice = s voiceSound # n c3Pitch # sustain (inverseSustain eeg3Energy eeg3Centroid)
      # gain (range gainLow gainHigh eeg3Energy)
      # djf (range djfLow djfHigh eeg3Centroid)
      # room (range roomLow roomHigh eeg3Mobility)
      # size (range sizeLow sizeHigh eeg3Mobility)
      # dry (range dryLow dryHigh eeg3Mobility) # pan 0.41
    c4Voice = s voiceSound # n c4Pitch # sustain (inverseSustain eeg4Energy eeg4Centroid)
      # gain (range gainLow gainHigh eeg4Energy)
      # djf (range djfLow djfHigh eeg4Centroid)
      # room (range roomLow roomHigh eeg4Mobility)
      # size (range sizeLow sizeHigh eeg4Mobility)
      # dry (range dryLow dryHigh eeg4Mobility) # pan 0.59
    p3Voice = s voiceSound # n p3Pitch # sustain (inverseSustain eeg5Energy eeg5Centroid)
      # gain (range gainLow gainHigh eeg5Energy)
      # djf (range djfLow djfHigh eeg5Centroid)
      # room (range roomLow roomHigh eeg5Mobility)
      # size (range sizeLow sizeHigh eeg5Mobility)
      # dry (range dryLow dryHigh eeg5Mobility) # pan 0.77
    p4Voice = s voiceSound # n p4Pitch # sustain (inverseSustain eeg6Energy eeg6Centroid)
      # gain (range gainLow gainHigh eeg6Energy)
      # djf (range djfLow djfHigh eeg6Centroid)
      # room (range roomLow roomHigh eeg6Mobility)
      # size (range sizeLow sizeHigh eeg6Mobility)
      # dry (range dryLow dryHigh eeg6Mobility) # pan 0.95

-- 4. START ALL SIX VOICES (EVALUATE THIS BLOCK, then start python) ----------------------------
do
  d1 $ f3Voice
  d2 $ f4Voice
  d3 $ c3Voice
  d4 $ c4Voice
  d5 $ p3Voice
  d6 $ p4Voice

-- 5. STOP EVERYTHING ----------------------------------
hush
