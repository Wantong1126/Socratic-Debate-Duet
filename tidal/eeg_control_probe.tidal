-- Six-voice EEG instrument. Evaluate after BootTidal.hs has started Tidal.
-- Python sends /ctrl <name> <float> to 127.0.0.1:6010 at approximately 4 Hz.
-- Each voice keeps one electrode independent: energy -> gain,
-- centroid -> low-pass brightness, Hjorth mobility -> continuous pattern speed.

let eegVoice number soundName pitchName =
      segment 4
    $ fast (range 0.55 2.4 $ cF 0.5 ("eeg" ++ show number ++ "_mobility"))
    $ s soundName
    # n pitchName
    # gain (range 0.03 0.42 $ cF 0.5 ("eeg" ++ show number ++ "_energy"))
    # lpf (range 350 6500 $ cF 0.5 ("eeg" ++ show number ++ "_centroid"))
    # legato 1.4

d1 $ eegVoice 1 "superpiano" "c3 e3 g3 e3"
d2 $ eegVoice 2 "superpiano" "d3 a3 f3 a3" # pan 0.7
d3 $ eegVoice 3 "supermandolin" "g2 d3 a3 d3" # pan 0.25
d4 $ eegVoice 4 "supermandolin" "a2 e3 b3 e3" # pan 0.75
d5 $ eegVoice 5 "supersaw" "c2 g2 eb3 g2" # pan 0.35
d6 $ eegVoice 6 "supersaw" "d2 a2 f3 a2" # pan 0.65

-- Stop all six voices.
-- hush
