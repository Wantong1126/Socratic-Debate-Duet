-- EEG control probe: technical validation only, not a composition.
--
-- Prerequisites (not installed by this repository): TidalCycles, SuperCollider,
-- SuperDirt, and a Tidal editor integration. Boot SuperDirt and Tidal normally.
-- The Python bridge sends: /ctrl <control-name> <float> to UDP 127.0.0.1:6010.
-- Start it with:
--   python -m src.eeg_control_demo --seconds 60 --open-dashboard
--
-- All probes use the same neutral SuperDirt synth and pitch. `segment 4` limits
-- control sampling to four updates/cycle. Mobility controls temporal activity;
-- energy controls gain; centroid controls low-pass register; entropy controls
-- tremolo depth. Evaluate definitions first, then one d1..d6 line at a time.

let eegProbe energy mobility centroid entropy =
      segment 4
    $ fast (range 0.5 3 mobility)
    $ s "superpiano"
    # n 0
    # gain (range 0.03 0.55 energy)
    # lpf (range 250 5000 centroid)
    # tremolodepth (range 0 0.7 entropy)
    # tremolorate 4

d1 $ eegProbe (cF 0.5 "f3_energy") (cF 0.5 "f3_mobility") (cF 0.5 "f3_centroid") (cF 0.5 "f3_entropy")
d2 $ eegProbe (cF 0.5 "f4_energy") (cF 0.5 "f4_mobility") (cF 0.5 "f4_centroid") (cF 0.5 "f4_entropy")
d3 $ eegProbe (cF 0.5 "c3_energy") (cF 0.5 "c3_mobility") (cF 0.5 "c3_centroid") (cF 0.5 "c3_entropy")
d4 $ eegProbe (cF 0.5 "c4_energy") (cF 0.5 "c4_mobility") (cF 0.5 "c4_centroid") (cF 0.5 "c4_entropy")
d5 $ eegProbe (cF 0.5 "p3_energy") (cF 0.5 "p3_mobility") (cF 0.5 "p3_centroid") (cF 0.5 "p3_entropy")
d6 $ eegProbe (cF 0.5 "p4_energy") (cF 0.5 "p4_mobility") (cF 0.5 "p4_centroid") (cF 0.5 "p4_entropy")

-- Pair inspection: evaluate only one of these d7 lines at a time.
-- Asymmetry -> gain, similarity -> filter, lag -> stereo position.
d7 $ segment 4 $ s "superpiano" # n 0 # gain (range 0.03 0.55 $ cF 0.5 "f3_f4_asymmetry") # lpf (range 250 5000 $ cF 0.5 "f3_f4_similarity") # pan (cF 0.5 "f3_f4_lag")
d7 $ segment 4 $ s "superpiano" # n 0 # gain (range 0.03 0.55 $ cF 0.5 "c3_c4_asymmetry") # lpf (range 250 5000 $ cF 0.5 "c3_c4_similarity") # pan (cF 0.5 "c3_c4_lag")
d7 $ segment 4 $ s "superpiano" # n 0 # gain (range 0.03 0.55 $ cF 0.5 "p3_p4_asymmetry") # lpf (range 250 5000 $ cF 0.5 "p3_p4_similarity") # pan (cF 0.5 "p3_p4_lag")

-- Silence all diagnostic probes.
hush
